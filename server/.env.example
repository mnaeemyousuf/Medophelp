# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000
# Hospital-local time zone: decides what "today" means for queues, check-in and dashboards
TZ=Asia/Karachi
# Transactions need a replica set. `npm run db:start` launches a local single-node set "rs0" on 27018.
MONGODB_URI=mongodb://127.0.0.1:27018/hms?replicaSet=rs0
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
# Set true behind HTTPS so cookies get the Secure flag
COOKIE_SECURE=false
FILE_STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
LOG_LEVEL=info
# Password used ONLY by `npm run seed` for demo accounts (development only)
SEED_DEMO_PASSWORD=
# Optional SMS gateway (HTTP POST {to, from, text} with a Bearer key). Leave SMS_GATEWAY_URL blank
# for demo mode: SMS are logged, never sent, and shown as "demo – not sent". In Pakistan the sender
# ID must be registered with PTA/operators before use.
SMS_GATEWAY_URL=
SMS_API_KEY=
SMS_SENDER_ID=
# Email and push have no provider adapter yet; they always run in demo mode (logged only).
# Days after issue before an unpaid invoice gets a payment reminder (max 3, a week apart). 0 disables.
PAYMENT_REMINDER_DAYS=7
